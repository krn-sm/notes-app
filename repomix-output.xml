            className="
              h-1.5
              w-1.5
              shrink-0
              rounded-full
              bg-gold
            "
          />

          <span>{tag.name}</span>

          <button
            type="button"
            onClick={() => onRemove(tag.id)}
            className="
              ml-1
              rounded
              text-ink-muted
              transition
              hover:text-ink
              border
            "
            aria-label={`Remove ${tag.name}`}
          >
            <X size={14} />
          </button>
        </Badge>
      ))}

      <div className="min-w-[140px] shrink-0">
        <TagInput
          ref={inputRef}
          value={value}
          onChange={onChange}
          onKeyDown={handleKeyDown}
        />
      </div>
    </div>
  );
};

export default EditorTags;
